# Safe local configuration template. Installer copies this to .env only if absent.
DB_ENGINE=sqlite
DB_NAME=TalentBridgeAI
# production | development | local — DEBUG only when development/local AND DJANGO_DEBUG=true
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=
SESSION_COOKIE_AGE=1209600

# Local Django admin — synced on every START/RESTART (prepare_local_auth). Private .env only.
LOCAL_ADMIN_USERNAME=mishraji
LOCAL_ADMIN_BOOTSTRAP_PASSWORD=choose-a-strong-local-password

# Google OAuth: set BOTH values to enable Google sign-in. Keep secrets private.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local Django only — Google Cloud redirect URI must match this host (+ /accounts/google/login/callback/).
# Do NOT set talentbridge.qd.je here; GitHub Pages sign-in does not use .env (no secret on Pages).
GOOGLE_OAUTH_REDIRECT_ORIGIN=http://127.0.0.1:8000

# Client ID must match config/google_oauth_client_id.txt (public) and GitHub variable GOOGLE_OAUTH_CLIENT_ID.
# Live domain: GitHub repo → Settings → Variables → GOOGLE_OAUTH_CLIENT_ID (public ID only).
# Never commit .env — it is listed in .gitignore and must stay on your PC only.

TALENTBRIDGEAI_AUTO_PUBLISH=1
# Windows: auto-start Django at sign-in (FIX_SERVER_PERMANENTLY.bat). Set 0 to disable.
TALENTBRIDGEAI_AUTO_LOGON=1
# TALENTBRIDGEAI_AUTO_COMMIT=0
# TALENTBRIDGEAI_FULL_TESTS=0

# Optional MySQL configuration (leave commented for the default SQLite setup).
# DB_USER=your_database_user
# DB_PASSWORD=replace-with-your-database-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Login protection (default on). Email signup verification (default off until SMTP is set).
# TALENTBRIDGE_REQUIRE_EMAIL_VERIFICATION=0
# LOGIN_RATE_LIMIT_ENABLED=1
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=6291456

# Optional SMTP configuration (leave unset for console email backend locally).
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=
