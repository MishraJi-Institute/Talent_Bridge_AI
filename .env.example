# Safe local configuration template. Installer copies this to .env only if absent.
DB_ENGINE=sqlite
DB_NAME=TalentBridgeAI
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=
SESSION_COOKIE_AGE=1209600

# Google OAuth: set BOTH values to enable Google sign-in. Keep secrets private.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Absolute origin Google redirects back to (local or deployed Django HTTPS).
# Local: http://127.0.0.1:8000
# Production example: https://talentbridge.qd.je
GOOGLE_OAUTH_REDIRECT_ORIGIN=

# When building GitHub Pages, optional real Django origin for Google handoff
# (static Pages cannot complete OAuth alone). Example: https://your-app.onrender.com
# TALENTBRIDGE_DJANGO_ORIGIN=

# One-click launcher (START_TALENTBRIDGEAI.bat): static build + git push if ahead + Render sync
TALENTBRIDGEAI_AUTO_PUBLISH=1
# Set to 1 to run full Django jobs test suite on every auto start (slow)
# TALENTBRIDGEAI_FULL_TESTS=0
# Render → Account Settings → API Keys (enables auto Google secret sync + deploy)
# RENDER_API_KEY=

# Optional MySQL configuration (leave commented for the default SQLite setup).
# DB_USER=your_database_user
# DB_PASSWORD=replace-with-your-database-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional SMTP configuration (leave unset for console email backend locally).
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=
