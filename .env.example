# Safe local configuration template. Installer copies this to .env only if absent.
DB_ENGINE=sqlite
DB_NAME=TalentBridgeAI
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=
SESSION_COOKIE_AGE=1209600

# Google OAuth: set BOTH values to enable Google sign-in. Keep secrets private.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local Django only — Google Cloud redirect URI must match this host (+ /accounts/google/login/callback/).
# Do NOT set talentbridge.qd.je here; GitHub Pages sign-in does not use .env (no secret on Pages).
GOOGLE_OAUTH_REDIRECT_ORIGIN=http://127.0.0.1:8000

# Live domain: GitHub repo → Settings → Variables → GOOGLE_OAUTH_CLIENT_ID (public ID only).
# Never commit .env — it is listed in .gitignore and must stay on your PC only.

TALENTBRIDGEAI_AUTO_PUBLISH=1
# TALENTBRIDGEAI_AUTO_COMMIT=0
# TALENTBRIDGEAI_FULL_TESTS=0

# Optional MySQL configuration (leave commented for the default SQLite setup).
# DB_USER=your_database_user
# DB_PASSWORD=replace-with-your-database-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional SMTP configuration (leave unset for console email backend locally).
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=
